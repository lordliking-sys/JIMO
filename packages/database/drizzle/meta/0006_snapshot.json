          "value": "(\"program_exercises\".\"load_mode\" = 'bodyweight' AND \"program_exercises\".\"target_load_kg\" IS NULL AND \"program_exercises\".\"target_assistance_kg\" IS NULL) OR (\"program_exercises\".\"load_mode\" IN ('weighted', 'external') AND \"program_exercises\".\"target_assistance_kg\" IS NULL) OR (\"program_exercises\".\"load_mode\" = 'assisted' AND \"program_exercises\".\"target_load_kg\" IS NULL)"
