PORT=3001
DATABASE_URL=
NODE_ENV=development

# Public mobile API origin; use your computer's reachable address on a phone.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Explicit development-only identity bypass. Keep false when using Clerk.
ALLOW_DEV_AUTH=false
# Mobile-only public configuration; never copy server secrets to apps/mobile.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# API-only secrets/configuration. Obtain from the same Clerk development instance.
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:8081,http://localhost:4173
# Development only; with explicit bypass, blank uses the stable bootstrap user.
DEV_USER_ID=
NEON_DEVELOPMENT_BRANCH_ID=br-purple-math-b1fsq2wb
API_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4173
