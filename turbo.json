{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["PORT", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "EXPO_NO_TELEMETRY",
    "EXPO_OFFLINE",
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "EXPO_UNSTABLE_HEADLESS",
    "DATABASE_URL",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "NODE_EXTRA_CA_CERTS"
  ],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.cjs",
    "prettier.config.cjs",
    "packages/config/**"
  ]
}
