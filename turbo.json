{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["EXPO_PUBLIC_API_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "NODE_ENV",
        "EXPO_PUBLIC_API_URL",
        "DEV_USER_ID",
        "NEON_DEVELOPMENT_BRANCH_ID",
        "API_ALLOWED_ORIGINS"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "EXPO_NO_TELEMETRY",
    "EXPO_OFFLINE",
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "EXPO_UNSTABLE_HEADLESS",
    "DATABASE_URL",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "NODE_EXTRA_CA_CERTS",
    "NEON_DEVELOPMENT_BRANCH_ID"
  ],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.cjs",
    "prettier.config.cjs",
    "packages/config/**"
  ]
}
