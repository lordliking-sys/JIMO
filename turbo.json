{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_AUTH_TEST"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["EXPO_PUBLIC_API_URL", "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["DATABASE_URL", "NEON_DEVELOPMENT_BRANCH_ID"]
    },
    "@jimo/api#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "NODE_ENV",
        "DEV_USER_ID",
        "NEON_DEVELOPMENT_BRANCH_ID",
        "API_ALLOWED_ORIGINS",
        "ALLOW_DEV_AUTH",
        "CLERK_ISSUER_URL",
        "CLERK_AUTHORIZED_PARTIES"
      ],
      "passThroughEnv": ["DATABASE_URL", "CLERK_SECRET_KEY", "CLERK_JWT_KEY"]
    }
  },
  "globalPassThroughEnv": [
    "EXPO_NO_TELEMETRY",
    "EXPO_OFFLINE",
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "EXPO_UNSTABLE_HEADLESS",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "NODE_EXTRA_CA_CERTS",
    "__UNSAFE_EXPO_HOME_DIRECTORY"
  ],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.cjs",
    "prettier.config.cjs",
    "packages/config/**"
  ]
}
