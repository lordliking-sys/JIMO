{
  "name": "jimo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@jimo/mobile",
    "dev:api": "turbo run dev --filter=@jimo/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "prettier": "3.9.9"
  }
}
