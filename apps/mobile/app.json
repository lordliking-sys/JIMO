{
  "expo": {
    "name": "JIMO",
    "slug": "jimo",
    "version": "0.1.0",
    "scheme": "jimo",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B0F",
          "image": "./assets/wordmark.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#090B0F",
            "image": "./assets/wordmark.png"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090B0F",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#090B0F"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#090B0F"
    }
  }
}
