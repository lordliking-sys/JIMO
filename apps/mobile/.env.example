# Only public mobile values. Copy to .env.local in this directory.
# LAN: http://<PC_WIFI_IPV4>:3001 or an HTTPS development endpoint.
# USB only: http://127.0.0.1:3001 with JIMO_DEV_API_TRANSPORT=adb + adb reverse.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_AI_IMPORT_ENABLED=false

# Never copy DATABASE_URL, CLERK_SECRET_KEY or OPENAI_API_KEY here.
# Do not enable EXPO_PUBLIC_AUTH_TEST on Android.
